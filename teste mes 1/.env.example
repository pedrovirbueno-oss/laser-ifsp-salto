# NEXO PRODUCTION — ENVIRONMENT CONFIGURATION TEMPLATE

# Demo Mode Control
# Set to 'true' for local interactive demo mode with mock repository
# Set to 'false' for production mode connecting strictly to Supabase
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Production Credentials (Required when NEXT_PUBLIC_DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Server-side Secrets (Never expose to frontend - Server Only)
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
